<Project>
  <PropertyGroup Label="Package settings">
    <Title>$(MSBuildProjectName)</Title>
    <Description>Format-agnostic, span-based .NET libraries for reading, validating, and querying XML-based schema formats such as XSD and Schematron.</Description>
    <RepositoryUrl>https://github.com/dailydevops/schemas.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dailydevops/schemas</PackageProjectUrl>
    <PackageReleaseNotes>$(PackageProjectUrl)/releases</PackageReleaseNotes>
    <PackageTags>schemas;xml;xsd;schematron;xpath;validation</PackageTags>
    <CopyrightYearStart>2026</CopyrightYearStart>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <DisableRecommendedPackage>Meziantou.Analyzer</DisableRecommendedPackage>
  </PropertyGroup>
  <!-- Target frameworks are defined here only: libraries, benchmarks and tests each get one fixed set. -->
  <PropertyGroup>
    <TargetFrameworks Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">netstandard2.0;net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)benchmarks'))">net10.0;net11.0</TargetFrameworks>
    <TargetFrameworks Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tests'))">net9.0;net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>
  <!-- Only the core library is packable; every other project stays unpackaged until its package lands. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'NetEvolve.Schemas'">
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Workaround, until https://github.com/GitTools/GitVersion/pull/4206 is released -->
    <GitVersionTargetFramework>net10.0</GitVersionTargetFramework>
  </PropertyGroup>
  <!-- NetEvolve.Defaults re-enables IsPackable after props evaluation; force it off again before any pack step. -->
  <Target Name="DisablePack" BeforeTargets="_IntermediatePack;GenerateNuspec" Condition="'$(MSBuildProjectName)' != 'NetEvolve.Schemas'">
    <PropertyGroup>
      <IsPackable>false</IsPackable>
    </PropertyGroup>
  </Target>
</Project>
