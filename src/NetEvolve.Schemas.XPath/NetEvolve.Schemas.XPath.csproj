<Project Sdk="Microsoft.NET.Sdk">
  <!-- Schematron and Xsd reach the internal syntax tree and the subset-profile seam (XP-50, #168). -->
  <ItemGroup>
    <InternalsVisibleTo Include="NetEvolve.Schemas.Schematron" />
    <InternalsVisibleTo Include="NetEvolve.Schemas.Xsd" />
    <InternalsVisibleTo Include="NetEvolve.Schemas.Schematron.Tests.Unit" />
    <InternalsVisibleTo Include="NetEvolve.Schemas.XPath.Tests.Unit" />
  </ItemGroup>
  <!-- Function groups register through a module initializer (#123, AP8); netstandard has no ModuleInitializerAttribute, and only this project compiles the polyfill. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="../Shared/ModuleInitializer/ModuleInitializerAttribute.cs" Link="Polyfills/ModuleInitializerAttribute.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NetEvolve.Schemas.Xml/NetEvolve.Schemas.Xml.csproj" />
  </ItemGroup>
</Project>
