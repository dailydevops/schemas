<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="CSharpier.MSBuild" Version="1.4.1" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <GlobalPackageReference Include="NetEvolve.Defaults" Version="2.10.122" />
    <GlobalPackageReference Include="NetEvolve.Analyzer" Version="0.20.92" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="NetEvolve.Arguments" Version="4.0.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.2" />
  </ItemGroup>
</Project>
