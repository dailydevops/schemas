<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The net9.0 leg runs the netstandard2.0 build of the library; net10.0 and net11.0 resolve their builds on their own. -->
    <LibraryLegTargetFramework Condition="'$(TargetFramework)' == 'net9.0'">TargetFramework=netstandard2.0</LibraryLegTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetEvolve.Schemas/NetEvolve.Schemas.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
    <ProjectReference Include="../../src/NetEvolve.Schemas.Xml/NetEvolve.Schemas.Xml.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
    <ProjectReference Include="../../src/NetEvolve.Schemas.XPath/NetEvolve.Schemas.XPath.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
    <ProjectReference Include="../../src/NetEvolve.Schemas.Xsd/NetEvolve.Schemas.Xsd.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
    <ProjectReference Include="../../src/NetEvolve.Schemas.Schematron/NetEvolve.Schemas.Schematron.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
    <ProjectReference Include="../../src/NetEvolve.Schemas.DependencyInjection/NetEvolve.Schemas.DependencyInjection.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>
</Project>
