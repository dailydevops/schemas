<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The net5.0 leg runs the netstandard2.0 build of the library; net6.0, net10.0 and net11.0 resolve their builds on their own. -->
    <LibraryLegTargetFramework Condition="'$(TargetFramework)' == 'net5.0'">TargetFramework=netstandard2.0</LibraryLegTargetFramework>
  </PropertyGroup>
  <!-- Restore ignores SetTargetFramework, so the polyfill packages of the netstandard2.0 build are declared here. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NetEvolve.Schemas.Conformance/NetEvolve.Schemas.Conformance.csproj" />
    <ProjectReference Include="../../src/NetEvolve.Schemas.Xsd/NetEvolve.Schemas.Xsd.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
  </ItemGroup>
</Project>
