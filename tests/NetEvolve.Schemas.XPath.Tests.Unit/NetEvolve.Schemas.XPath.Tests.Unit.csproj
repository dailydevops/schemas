<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The net9.0 leg runs the netstandard2.0 build of the library; net10.0 and net11.0 resolve their builds on their own. -->
    <LibraryLegTargetFramework Condition="'$(TargetFramework)' == 'net9.0'">TargetFramework=netstandard2.0</LibraryLegTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetEvolve.Schemas.XPath/NetEvolve.Schemas.XPath.csproj" SetTargetFramework="$(LibraryLegTargetFramework)" />
    <!-- Fetches the pinned Unicode Character Database by checksum for the case mapping and normalization table tests. -->
    <ProjectReference Include="../NetEvolve.Schemas.Conformance/NetEvolve.Schemas.Conformance.csproj" />
  </ItemGroup>
</Project>
