<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Open source project without revenue: Verify SponsorCheck exemption (max term 12 months, renew before expiry). -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-11</Verify_SponsorshipExemptionUntil>
    <!-- TUnit assertion awaitables have no ConfigureAwait (MA0004) and are awaited as statements (IDE0058). -->
    <NoWarn>$(NoWarn);MA0004;IDE0058</NoWarn>
    <!-- Suppress warnings for target framework support -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NU1701;CA5394;</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Polyfills compile into the leaf test projects only: a support library with InternalsVisibleTo would make the same helpers ambiguous in its tests. -->
    <Compile Condition="$(MSBuildProjectName.Contains('.Tests.'))" Include="$(MSBuildThisFileDirectory)Shared/Polyfills/*.cs" Link="Polyfills/%(Filename)%(Extension)" />
    <PackageReference Include="TUnit" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'NetEvolve.Schemas.Testing'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)NetEvolve.Schemas.Testing/NetEvolve.Schemas.Testing.csproj" />
  </ItemGroup>
</Project>
