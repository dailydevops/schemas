<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- The gate has no BenchmarkDotNet dependency, so its sources are linked instead of referencing the Exe project. -->
    <Compile Include="../../benchmarks/NetEvolve.Schemas.Benchmarks/Gate/*.cs" LinkBase="Gate" />
    <!-- The invoice generator is plain BCL code, so the test legs that the Exe project cannot target still check its bytes. -->
    <Compile Include="../../benchmarks/NetEvolve.Schemas.Benchmarks/XPath/Core/XPathBenchmarkInput.cs" LinkBase="XPath/Core" />
  </ItemGroup>
</Project>
